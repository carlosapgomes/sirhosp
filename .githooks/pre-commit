#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! command -v npx >/dev/null 2>&1; then
  echo "Erro: npx nao encontrado. Instale Node.js/npm para rodar markdown lint no pre-commit." >&2
  exit 1
fi

mapfile -t staged_md < <(
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.md$' \
    | grep -vE '^(\.pi/|\.codex/)' \
    || true
)

if [ ${#staged_md[@]} -eq 0 ]; then
  exit 0
fi

echo "[pre-commit] Formatando e validando markdown staged (${#staged_md[@]} arquivo(s))..."
npx --yes prettier --write "${staged_md[@]}"

MARKDOWNLINT_CLI2_CONFIG="${MARKDOWNLINT_CLI2_CONFIG:-.markdownlint-cli2.yaml}"
if [ -f "$MARKDOWNLINT_CLI2_CONFIG" ]; then
  npx --yes markdownlint-cli2 --config "$MARKDOWNLINT_CLI2_CONFIG" "${staged_md[@]}"
else
  npx --yes markdownlint-cli2 "${staged_md[@]}"
fi

git add "${staged_md[@]}"

echo "[pre-commit] Markdown OK."
