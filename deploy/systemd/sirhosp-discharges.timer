# SIRHOSP — hourly current-day discharge timer (America/Bahia, RPSA-S12).
# Fires every hour at minute 13, staggered from the 05:00 D-1 recovery and
# the :47 stale sweep. America/Bahia on the OnCalendar line makes the
# schedule host-timezone independent. Persistent=true runs a missed trigger
# after downtime. Deterministic on purpose: no start randomization, so the
# three schedules keep fixed, distinct offsets. Enabled only by explicit
# operator action (never on install).
[Unit]
Description=SIRHOSP — Timer de extração horária de altas do dia (America/Bahia)
Documentation=https://github.com/carlosapgomes/sirhosp

[Timer]
OnCalendar=*-*-* *:13:00 America/Bahia
Persistent=true
RemainAfterElapse=no

[Install]
WantedBy=timers.target
